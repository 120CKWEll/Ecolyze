# ── Supabase (จำเป็นทุกฟีเจอร์ที่เกี่ยวกับบัญชี) ──
# สร้างโปรเจกต์ฟรีที่ https://supabase.com แล้วคัดลอกจาก Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google Gemini AI (จำเป็นสำหรับฟีเจอร์สแกนขยะ) ──
# สร้าง API key ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
